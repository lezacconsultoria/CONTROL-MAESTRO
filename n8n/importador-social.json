    {"id":"parse","name":"Parsear Media","type":"n8n-nodes-base.code","typeVersion":2,"position":[1300,300],
     "parameters":{"jsCode":"const r = $input.first().json;\nconst d = r.data?.data ? r.data : (r.data?.data?.data ? r.data.data : r.data || {});\nconst posts = d.data || [];\nconst next = d.paging?.cursors?.after && d.paging?.next ? d.paging.cursors.after : '';\nconst pagina = ($('Init Cursor').first().json.pagina || 0);\nlet prev = 0; try { prev = $('Siguiente Página').last().json.pagina; } catch (e) {}\nreturn [{ json: { posts, next, pagina: prev } }];"}},
